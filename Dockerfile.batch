FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv export --frozen --no-dev --extra batch --no-emit-project \
      --output-file /tmp/requirements.txt \
    && python -m pip install --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
COPY src ./src
RUN python -m pip install --no-deps .
COPY examples/refresh-config.yaml /app/config/refresh-config.yaml

USER 65532:65532
ENTRYPOINT ["tableau-hyper-refresher"]
